# Core server
PC_REMOTE_HOST=127.0.0.1
PC_REMOTE_PORT=8787
PC_REMOTE_NAME=Home PC

# Guacamole is reverse proxied through /guacamole/ so it stays inside the PWA.
GUACAMOLE_ORIGIN=http://127.0.0.1:8080
# JDBC auth-provider identifier used to build the direct MRD Desktop route.
GUACAMOLE_DATASOURCE=postgresql

# Safety: power actions are disabled until you deliberately enable them.
ALLOW_POWER_CONTROLS=false

# Optional Windows Audio Router helper override.
# Normally scripts/setup-audio-router.ps1 installs this to bin/mrd-audio-router.exe.
# MRD_AUDIO_HELPER=C:\Mini-Remote-Desktop\bin\mrd-audio-router.exe

# Secret mode virtual-display defaults. The Windows virtual workspace renders at
# 2x the iPhone 17 Pro Max CSS viewport and streams down to 440x956.
# Run scripts/setup-secret-transport.ps1 once as Administrator before using Secret.
MRD_SECRET_WIDTH=880
MRD_SECRET_HEIGHT=1912
MRD_SECRET_STREAM_WIDTH=440
MRD_SECRET_STREAM_HEIGHT=956
MRD_SECRET_FPS=20
# Optional FFmpeg executable override if ffmpeg.exe is not in PATH/WinGet Links.
# MRD_FFMPEG=C:\path\to\ffmpeg.exe

# Dedicated PC-powered mobile Chromium Browser Engine.
# Chrome 136+ requires remote debugging to use a non-default user-data-dir;
# MRD always uses .runtime/browser-engine/profile rather than your normal Chrome profile.
MRD_BROWSER_WIDTH=440
MRD_BROWSER_HEIGHT=956
MRD_BROWSER_DPR=3
MRD_BROWSER_DEBUG_PORT=9223
MRD_BROWSER_QUALITY=72
MRD_BROWSER_HEADLESS=true
# Optional Chrome executable override.
# MRD_CHROME=C:\Program Files\Google\Chrome\Application\chrome.exe
# Optional mobile user-agent override. By default MRD uses Chrome's normal UA plus mobile viewport emulation.
# MRD_BROWSER_USER_AGENT=

# Optional development override: offline | asleep | onlineUnlocked | onlineLocked
# PC_REMOTE_DEMO_STATE=onlineLocked
